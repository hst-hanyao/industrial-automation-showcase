      "        private async Task LoadSelectedRunAsync(HistoryViewModel model, HistoryRunSummaryRow selectedRun)",
      "        {",
      "            var request = BeginTrendDisplayRequest();",
      "            ClearCharts();",
      "            var totalStopwatch = Stopwatch.StartNew();",
      "",
      "            try",
      "            {",
      "                var result = await model.LoadRunTrendsAsync(selectedRun.RunId, request.Cancellation.Token);",
      "                ThrowIfNotCurrent(request, model);",
      "",
      "                var snapshotPreparationStopwatch = Stopwatch.StartNew();",
      "                var snapshots = await Task.Run(",
      "                    () => CreateSnapshots(result, request.Cancellation.Token),",
      "                    request.Cancellation.Token);",
      "                snapshotPreparationStopwatch.Stop();",
      "                ThrowIfNotCurrent(request, model);",
      "",
      "                var preparationElapsed = result.PreparationElapsed + snapshotPreparationStopwatch.Elapsed;",
      "                var chartStopwatch = new Stopwatch();",
      "                TrendDataState[] chartStates;",
      "",
      "                SetChartInteractionEnabled(false);",
      "                try",
      "                {",
      "                    using (var voltageAwaiter = new ChartStateAwaiter(VoltageTrendChart, request.Cancellation.Token))",
      "                    using (var currentAwaiter = new ChartStateAwaiter(CurrentTrendChart, request.Cancellation.Token))",
      "                    {",
      "                        chartStopwatch.Start();",
      "                        VoltageTrendChart.LoadSnapshot(snapshots.Voltage);",
      "                        CurrentTrendChart.LoadSnapshot(snapshots.Current);",
      "                        await Task.WhenAll(voltageAwaiter.Completion, currentAwaiter.Completion);",
      "                        chartStates = new[] { VoltageTrendChart.DataState, CurrentTrendChart.DataState };",
      "                    }"
    ]
  },
