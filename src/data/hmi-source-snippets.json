      "        private async Task<ST_PLT_AdsStatus> ReadCoherentStatusAsync(CancellationToken cancellationToken)",
      "        {",
      "            var value = await ReadAnyAsync<ST_PLT_AdsStatus>(statusHandle, cancellationToken).ConfigureAwait(false);",
      "            ValidateStatusLayout(value);",
      "            if (value.PlcSequenceBegin == value.PlcSequenceEnd)",
      "            {",
      "                return value;",
      "            }",
      "",
      "            value = await ReadAnyAsync<ST_PLT_AdsStatus>(statusHandle, cancellationToken).ConfigureAwait(false);",
      "            ValidateStatusLayout(value);",
      "            if (value.PlcSequenceBegin != value.PlcSequenceEnd)",
      "            {",
      "                throw new InvalidOperationException(",
      "                    $\"{StatusSymbol}快照不完整：begin={value.PlcSequenceBegin}, end={value.PlcSequenceEnd}。\");",
      "            }",
      "",
      "            return value;",
      "        }"
    ]
  },
