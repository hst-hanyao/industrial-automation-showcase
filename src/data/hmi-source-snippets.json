      "        private UiStatusSnapshot BuildUiStatus(PlcRawSnapshot raw)",
      "        {",
      "            var ui = new UiStatusSnapshot",
      "            {",
      "                CommunicationText = FormatCommunicationState(raw.ConnectionState),",
      "                CommunicationState = raw.ConnectionState,",
      "                AlarmText = raw.HasAlarm ? \"有报警\" : \"无报警\",",
      "                AlarmCountText = raw.AlarmCount.ToString(),",
      "                HeartbeatText = raw.Heartbeat > 0 ? raw.Heartbeat.ToString() : \"-\",",
      "                RunStateText = FormatRunState(raw.RunState),",
      "                PltModeText = FormatPltMode(raw.PltState),",
      "                CurrentModuleText = raw.CurrentModule,",
      "                CurrentStepText = raw.CurrentStep,",
      "                FabStatusText = \"未连接\"",
      "            };",
      "",
      "            var recentEvents = Stage7.RecentFiveEvents.Count > 0",
      "                ? Stage7.RecentFiveEvents",
      "                : raw.RecentEvents;",
      "",
      "            foreach (var item in recentEvents.Take(5))",
      "            {",
      "                ui.RecentFiveEvents.Add(item);",
      "            }",
      "",
      "            return ui;",
      "        }"
    ]
  },
