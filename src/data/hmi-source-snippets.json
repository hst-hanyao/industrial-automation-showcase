      "        private async Task WriteInputPacketAsync(CancellationToken cancellationToken)",
      "        {",
      "            commandSequence = unchecked(commandSequence + 1);",
      "            if (commandSequence == 0)",
      "            {",
      "                commandSequence = 1;",
      "            }",
      "",
      "            Com_AdsInput.LayoutVersion = PltAdsLayout.AdsInputVersion;",
      "            Com_AdsInput.LayoutSize = PltAdsLayout.AdsInputSize;",
      "            Com_AdsInput.CommandSequenceBegin = commandSequence;",
      "            Com_AdsInput.CommandSequenceEnd = commandSequence;",
      "            await WriteAnyAsync(inputHandle, Com_AdsInput, cancellationToken).ConfigureAwait(false);",
      "        }",
      "",
      "        private async Task<T> ReadAnyAsync<T>(uint handle, CancellationToken cancellationToken)",
      "        {",
      "            var result = await client.ReadAnyAsync(handle, typeof(T), cancellationToken).ConfigureAwait(false);",
      "            result.ThrowOnError();",
      "            return (T)result.Value;",
      "        }",
      "",
      "        private async Task WriteAnyAsync(uint handle, object value, CancellationToken cancellationToken)",
      "        {",
      "            var result = await client.WriteAnyAsync(handle, value, cancellationToken).ConfigureAwait(false);",
      "            result.ThrowOnError();",
      "        }"
    ]
