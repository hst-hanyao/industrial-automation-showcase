    "id": "ads-read",
    "file": "Infrastructure/AdsCommunicationClient.cs",
    "symbol": "AdsCommunicationClient.ReadSnapshotAsync",
    "language": "csharp",
    "startLine": 54,
    "lines": [
      "        public async Task<PlcRawSnapshot> ReadSnapshotAsync(CancellationToken cancellationToken)",
      "        {",
      "            ThrowIfDisposed();",
      "            var readLease = await AcquireReadAsync(cancellationToken).ConfigureAwait(false);",
      "            try",
      "            {",
      "                try",
      "                {",
      "                    ThrowIfDisposed();",
      "                    EnsureConnected();",
      "                    var now = DateTime.UtcNow;",
      "                    if (now >= nextHeartbeatUtc)",
      "                    {",
      "                        heartbeat = !heartbeat;",
      "                        await WriteAnyAsync(hmiConnectHandle, heartbeat, cancellationToken).ConfigureAwait(false);",
      "                        nextHeartbeatUtc = now.AddMilliseconds(500);",
      "                    }",
      "",
      "                    var shouldClearUnsafeRequests = ApplyStatusSnapshot(",
      "                        await ReadCoherentStatusAsync(cancellationToken).ConfigureAwait(false));",
      "                    if (shouldClearUnsafeRequests)",
      "                    {",
      "                        await writeGate.WaitAsync(cancellationToken).ConfigureAwait(false);",
      "                        try",
      "                        {",
      "                            ClearUnsafeLocalRequests();",
      "                        }",
      "                        finally",
      "                        {",
      "                            writeGate.Release();",
      "                        }",
      "                    }",
      "",
      "                    // Com_AdsInput 由写入路径维护，复制时短暂取得写锁，避免状态映射读到半包。",
      "                    ST_PLT_AdsInput inputSnapshot;",
      "                    await writeGate.WaitAsync(cancellationToken).ConfigureAwait(false);",
      "                    try",
      "                    {",
      "                        inputSnapshot = Com_AdsInput;",
      "                    }",
      "                    finally",
      "                    {",
      "                        writeGate.Release();",
      "                    }",
      "",
      "                    Current_AdsStatus = MapCurrentAdsStatus(GetStatusSnapshot(), inputSnapshot, true);",
      "                    return BuildRawSnapshot(true, null);",
      "                }"
    ]
  },
