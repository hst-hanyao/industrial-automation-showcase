      "        public void LoadSnapshot(TrendDataSnapshot snapshot)",
      "        {",
      "            if (snapshot == null)",
      "            {",
      "                throw new ArgumentNullException(nameof(snapshot));",
      "            }",
      "",
      "            VerifyAccess();",
      "            var version = Interlocked.Increment(ref snapshotVersion);",
      "            Interlocked.Increment(ref historyRequestVersion);",
      "            SetValue(DataStatePropertyKey, TrendDataState.Loading);",
      "            SetViewMode(TrendViewMode.History);",
      "            var maximum = MaxHistoryPointsPerSeries;",
      "            var bufferOperation = bufferManager.BeginHistoryOperation();",
      "            var cancellationToken = BeginHistoryLoad();",
      "            Dispatcher.BeginInvoke(DispatcherPriority.Background, new Action(() =>",
      "            {",
      "                if (version == snapshotVersion && !cancellationToken.IsCancellationRequested)",
      "                {",
      "                    var validatedSnapshot = ValidateHistorySnapshot(snapshot, out var validationPartial, out var rejectionEvents);",
      "                    var snapshotPartial = validationPartial || IsHistorySnapshotPartial(validatedSnapshot);",
      "                    StartHistorySnapshotReplace(validatedSnapshot, snapshotPartial, maximum, bufferOperation, version, cancellationToken);",
      "                    PublishDataRejectedEvents(rejectionEvents);",
      "                }",
      "            }));",
      "        }"
    ]
  },
