      "        private PlcRawSnapshot BuildRawSnapshot(bool connected, string error)",
      "        {",
      "            return new PlcRawSnapshot",
      "            {",
      "                ConnectionState = connected ? PlcConnectionState.Connected : PlcConnectionState.Faulted,",
      "                IsConnected = connected,",
      "                HasAlarm = Com_AdsStatus.bHardFault,",
      "                AlarmCount = Com_AdsStatus.bHardFault ? 1 : 0,",
      "                Heartbeat = unchecked((int)Com_AdsStatus.PlcSequenceBegin),",
      "                PltState = Com_AdsStatus.State,",
      "                RunState = Com_AdsStatus.State == E_PLT_State.Fault",
      "                    ? EquipmentRunState.Alarm",
      "                    : EquipmentRunState.Ready,",
      "                CurrentModule = \"PLT1\",",
      "                CurrentStep = error ?? Com_AdsStatus.State.ToString()",
      "            };",
      "        }",
      ""
    ]
