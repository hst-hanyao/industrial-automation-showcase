    "id": "recipe-transaction",
    "file": "Repositories/SqliteStage4Repository.cs",
    "symbol": "SqliteStage4Repository.SaveRecipe",
    "language": "csharp",
    "startLine": 165,
    "lines": [
      "        public int SaveRecipe(RecipeRow recipe, IEnumerable<RecipeStepRow> steps)",
      "        {",
      "            EnsureSchema();",
      "            using (var connection = connectionFactory.OpenConnection())",
      "            using (var transaction = connection.BeginTransaction())",
      "            {",
      "                var now = DateTime.Now.ToString(\"yyyy-MM-dd HH:mm:ss\");",
      "                int recipeId = recipe.Id;",
      "                using (var command = connection.CreateCommand())",
      "                {",
      "                    command.Transaction = transaction;",
      "                    if (recipe.Id <= 0)",
      "                    {",
      "                        command.CommandText =",
      "                            \"INSERT INTO Recipes (Name, Version, IsActive, Description, CreatedAt, UpdatedAt) \" +",
      "                            \"VALUES (@Name, @Version, @IsActive, @Description, @CreatedAt, @UpdatedAt); \" +",
      "                            \"SELECT last_insert_rowid();\";",
      "                        command.Parameters.AddWithValue(\"@CreatedAt\", now);",
      "                    }",
      "                    else",
      "                    {",
      "                        command.CommandText =",
      "                            \"UPDATE Recipes SET Name = @Name, Version = @Version, IsActive = @IsActive, \" +",
      "                            \"Description = @Description, UpdatedAt = @UpdatedAt WHERE Id = @Id; \" +",
      "                            \"SELECT @Id;\";",
      "                        command.Parameters.AddWithValue(\"@Id\", recipe.Id);",
      "                    }",
      "",
      "                    command.Parameters.AddWithValue(\"@Name\", recipe.Name ?? string.Empty);",
      "                    command.Parameters.AddWithValue(\"@Version\", recipe.Version ?? string.Empty);",
      "                    command.Parameters.AddWithValue(\"@IsActive\", recipe.IsActive ? 1 : 0);",
      "                    command.Parameters.AddWithValue(\"@Description\", recipe.Description ?? string.Empty);",
      "                    command.Parameters.AddWithValue(\"@UpdatedAt\", now);",
      "                    recipeId = Convert.ToInt32(command.ExecuteScalar());",
      "                }",
      "",
      "                using (var deleteCommand = connection.CreateCommand())",
      "                {",
      "                    deleteCommand.Transaction = transaction;",
      "                    deleteCommand.CommandText = \"DELETE FROM RecipeSteps WHERE RecipeId = @RecipeId;\";",
      "                    deleteCommand.Parameters.AddWithValue(\"@RecipeId\", recipeId);",
      "                    deleteCommand.ExecuteNonQuery();",
      "                }",
      "",
      "                foreach (var step in steps)",
      "                {",
      "                    using (var insertCommand = connection.CreateCommand())",
      "                    {",
      "                        insertCommand.Transaction = transaction;",
      "                        insertCommand.CommandText =",
      "                            \"INSERT INTO RecipeSteps (RecipeId, StepNo, Module, StepName, CurrentSet, VoltageSet, TimeSeconds, TemperatureSet, FlowSet, IsEnabled) \" +",
      "                            \"VALUES (@RecipeId, @StepNo, @Module, @StepName, @CurrentSet, @VoltageSet, @TimeSeconds, @TemperatureSet, @FlowSet, @IsEnabled);\";",
      "                        insertCommand.Parameters.AddWithValue(\"@RecipeId\", recipeId);",
      "                        insertCommand.Parameters.AddWithValue(\"@StepNo\", step.StepNo);",
      "                        insertCommand.Parameters.AddWithValue(\"@Module\", step.Module ?? string.Empty);",
      "                        insertCommand.Parameters.AddWithValue(\"@StepName\", step.StepName ?? string.Empty);",
      "                        insertCommand.Parameters.AddWithValue(\"@CurrentSet\", step.CurrentSet);",
      "                        insertCommand.Parameters.AddWithValue(\"@VoltageSet\", step.VoltageSet);",
      "                        insertCommand.Parameters.AddWithValue(\"@TimeSeconds\", step.TimeSeconds);",
      "                        insertCommand.Parameters.AddWithValue(\"@TemperatureSet\", step.TemperatureSet);",
      "                        insertCommand.Parameters.AddWithValue(\"@FlowSet\", step.FlowSet);",
      "                        insertCommand.Parameters.AddWithValue(\"@IsEnabled\", step.IsEnabled ? 1 : 0);",
      "                        insertCommand.ExecuteNonQuery();",
      "                    }",
      "                }",
      "",
      "                transaction.Commit();",
      "                return recipeId;",
      "            }",
      "        }"
    ]
  },
