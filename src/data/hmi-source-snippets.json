      "        public async Task<HistoryTrendLoadResult> LoadRunTrendsAsync(string runId, CancellationToken cancellationToken)",
      "        {",
      "            if (string.IsNullOrWhiteSpace(runId))",
      "            {",
      "                throw new ArgumentException(\"运行记录号不能为空。\", nameof(runId));",
      "            }",
      "",
      "            var linkedCancellation = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken);",
      "            CancellationTokenSource previousCancellation;",
      "            long requestVersion;",
      "            lock (trendLoadSync)",
      "            {",
      "                previousCancellation = trendLoadCancellation;",
      "                trendLoadCancellation = linkedCancellation;",
      "                requestVersion = ++trendLoadVersion;",
      "            }",
      "",
      "            TryCancel(previousCancellation);",
      "            ClearTrendSamples();",
      "            StatusMessage = \"正在读取 \" + runId + \" 的四通道曲线数据...\";",
      "",
      "            try",
      "            {",
      "                var databaseStopwatch = Stopwatch.StartNew();",
      "                var rows = await historyRepository.LoadRunProcessValuesAsync(runId, linkedCancellation.Token);",
      "                databaseStopwatch.Stop();",
      "                ThrowIfNotLatest(linkedCancellation, requestVersion);",
      "",
      "                var isPerformanceRun = runId.StartsWith(",
      "                    PerformanceRunPrefix,",
      "                    StringComparison.Ordinal);",
      "                var preparationStopwatch = Stopwatch.StartNew();",
      "                var grouped = await Task.Run(",
      "                    () => GroupTrendSamples(rows, !isPerformanceRun, linkedCancellation.Token),",
      "                    linkedCancellation.Token);",
      "                preparationStopwatch.Stop();",
      "                ThrowIfNotLatest(linkedCancellation, requestVersion);"
    ]
  },
