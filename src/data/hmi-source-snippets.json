      "        private static Plt1AdsStatusSnapshot MapCurrentAdsStatus(",
      "            ST_PLT_AdsStatus status,",
      "            ST_PLT_AdsInput command,",
      "            bool connected)",
      "        {",
      "            var io = status.IoVar;",
      "            var errors = status.Error ?? new bool[16];",
      "            var result = new Plt1AdsStatusSnapshot",
      "            {",
      "                IsConnected = connected && status.HmiConnected,",
      "                HmiConnected = status.HmiConnected,",
      "                L0WarningActive = status.bL0WarningActive,",
      "                HardFault = status.bHardFault,",
      "                State = (short)status.State,",
      "                IsManual = status.State == E_PLT_State.Manual || status.State == E_PLT_State.Repair,",
      "                ManualBaseSafetyOk = status.bManualBaseSafetyOk,",
      "                ManualMotionOk = status.bManualBaseSafetyOk,",
      "                ManualFluidOk = status.bManualFluidOk,",
      "                ManualRectifierOk = false,",
      "                FaultCode = 0,",
      "                AxisZ = MapAxis(status.AxisZ),",
      "                AxisRotary = MapAxis(status.AxisRotary),",
      "                Errors = (bool[])errors.Clone(),",
      "                ChillerPortBusy = status.Chiller.Busy,",
      "                ChillerActiveIndex = status.Chiller.ActiveChillerIndex,",
      "                ChillerState = status.Chiller.State",
      "            };",
