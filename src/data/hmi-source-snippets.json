    "id": "ads-manual",
    "file": "Infrastructure/AdsCommunicationClient.cs",
    "symbol": "AdsCommunicationClient.SetManualBooleanAsync",
    "language": "csharp",
    "startLine": 214,
    "lines": [
      "        public async Task SetManualBooleanAsync(",
      "            Plt1ManualCommandKey key,",
      "            int channel,",
      "            bool value,",
      "            CancellationToken cancellationToken)",
      "        {",
      "            ThrowIfDisposed();",
      "            var writeLease = await AcquireWriteAsync(cancellationToken).ConfigureAwait(false);",
      "            try",
      "            {",
      "                ThrowIfDisposed();",
      "                EnsureConnected();",
      "                EnsureManualWriteAllowed(key);",
      "                var previousInput = Com_AdsInput;",
      "                SetBoolean(ref Com_AdsInput, key, channel, value);",
      "                try",
      "                {",
      "                    await WriteInputPacketAsync(cancellationToken).ConfigureAwait(false);",
      "",
      "                    // 脉冲请求仅在本次新序号快照中置 TRUE；成功发送后立即清除本地位。",
      "                    if (value && IsPulse(key))",
      "                    {",
      "                        SetBoolean(ref Com_AdsInput, key, channel, false);",
      "                    }",
      "                }",
      "                catch",
      "                {",
      "                    // 写入没有成功时回滚整个本地快照，避免后续写入重新夹带失败请求。",
      "                    Com_AdsInput = previousInput;",
      "                    throw;",
      "                }",
      "            }",
      "            finally",
      "            {",
      "                writeLease.Dispose();",
      "            }",
      "        }"
    ]
  },
